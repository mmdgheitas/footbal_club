# Environment Configuration
# Copy this file to .env and update values

# Application Settings
APP_ENV=debug
APP_DEBUG=true
APP_URL=http://localhost
# Timezone of the club. Every date/time stored in the database is a wall clock
# in this zone, and the application pins the Node process and the MySQL session
# to it (see nestjs/src/common/helpers/time.helper.ts).
APP_TIMEZONE=Asia/Tehran

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=football_club
DB_USER=root
DB_PASSWORD=

# SMS Configuration
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@footballclub.local

# Session Configuration
SESSION_LIFETIME=3600
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict

# ---------------------------------------------------------------------------
# درگاه پرداخت آنلاین — online payment gateway
#
# PAYMENT_GATEWAY : which driver (mock | bitpay | zarinpal)
# PAYMENT_MODE    : mock = built-in simulator, no money moves
#                   sandbox = the gateway's test environment
#                   production = the real thing (needs PAYMENT_MERCHANT_ID)
# PAYMENT_CALLBACK_URL : public origin the gateway returns the payer to.
#                   Leave empty to use the origin of the incoming request;
#                   set it explicitly behind a reverse proxy or a tunnel, e.g.
#                   https://club.example.com
# PAYMENT_CURRENCY_MULTIPLIER : stored amounts are تومان; Iranian gateways
#                   charge ریال, so 10. Set to 1 for a gateway that takes تومان.
# ---------------------------------------------------------------------------
# بیت‌پی: کلید API را از پنل کاربری، بخش «مدیریت درگاه» بردارید و در
# PAYMENT_MERCHANT_ID (یا PAYMENT_API_KEY) بگذارید، سپس:
#   PAYMENT_GATEWAY=bitpay
#   PAYMENT_MODE=production
PAYMENT_GATEWAY=mock
PAYMENT_MODE=mock
PAYMENT_MERCHANT_ID=
PAYMENT_API_KEY=
PAYMENT_CALLBACK_URL=
PAYMENT_CURRENCY_MULTIPLIER=10
PAYMENT_MIN_AMOUNT=1000
PAYMENT_TIMEOUT=900
