# Environment Configuration
# Copy this file to .env and update values

# Application Settings
APP_ENV=debug
APP_DEBUG=true
APP_URL=http://localhost

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=football_club
DB_USER=root
DB_PASSWORD=

# SMS Configuration
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=

# Email Configuration
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@footballclub.local

# Session Configuration
SESSION_LIFETIME=3600
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Strict
