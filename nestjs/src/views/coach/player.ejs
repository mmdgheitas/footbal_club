<%
/**
 * پرونده فنی بازیکن از دید مربی.
 * مربی می‌تواند عملکرد و امتیاز ثبت کند؛ ویرایش اطلاعات پایه، تأیید ثبت‌نام،
 * اطلاعات مالی و تعیین نشان در این صفحه وجود ندارد (مخصوص مدیر ارشد).
 */
const p = locals.player || {};
const attendance = locals.attendance || { records: [], percentage: 0, present: 0, absent: 0, late: 0, excused: 0 };
const performance = locals.performance || [];
const summary = locals.summary || [];
const scores = locals.scores || [];
const badges = locals.badges || [];
const rank = locals.rank || { rank: 0, outOf: 0 };
const types = locals.performance_types || {};
const matchTypes = locals.match_types || {};
const positions = locals.positions || {};
const feet = locals.feet || {};
const dash = '—';
%>

<div class="tile-grid">
    <div class="tile is-gold">
        <span class="tile-icon">⭐</span>
        <span class="tile-value"><%- toPersian(p.total_score || 0) %></span>
        <span class="tile-label">امتیاز کل</span>
    </div>
    <div class="tile">
        <span class="tile-icon">🥇</span>
        <span class="tile-value"><%- toPersian(rank.rank) %></span>
        <span class="tile-label">رتبه از <%- toPersian(rank.outOf) %></span>
    </div>
    <div class="tile">
        <span class="tile-icon">✅</span>
        <span class="tile-value"><%- toPersian(attendance.percentage) %>٪</span>
        <span class="tile-label">درصد حضور</span>
    </div>
    <div class="tile">
        <span class="tile-icon">🏅</span>
        <span class="tile-value"><%- toPersian(badges.length) %></span>
        <span class="tile-label">نشان</span>
    </div>
</div>

<div class="grid-2">
    <div class="panel-card">
        <h3><span class="em">🧬</span> اطلاعات فنی</h3>
        <table class="mini-table">
            <tr><th>نام</th><td><%- esc(p.name || dash) %></td></tr>
            <tr><th>کلاس</th><td><%- esc(p.classroom_name || dash) %></td></tr>
            <tr><th>پست تخصصی</th><td><%- esc(positions[p.position] || dash) %></td></tr>
            <tr><th>پای برتر</th><td><%- esc(feet[p.preferred_foot] || dash) %></td></tr>
            <tr><th>قد / وزن</th><td><%- p.height_cm ? toPersian(p.height_cm) + ' cm' : dash %> · <%- p.weight_kg ? toPersian(p.weight_kg) + ' kg' : dash %></td></tr>
            <tr><th>رده سنی</th><td><%- esc((constants.AGE_CATEGORIES[p.age_category] || {}).label || dash) %></td></tr>
        </table>
        <p class="text-muted mt-2" style="font-size:.82rem;">
            🔒 ویرایش اطلاعات پایه و اطلاعات مالی بازیکن در اختیار مدیریت باشگاه است.
        </p>
    </div>

    <div class="panel-card">
        <h3><span class="em">📊</span> خلاصه عملکرد</h3>
        <% if (summary.length === 0) { %>
            <div class="empty-state"><span class="em">📉</span> عملکردی ثبت نشده است.</div>
        <% } else { %>
        <table class="mini-table">
            <thead><tr><th>نوع</th><th>مجموع</th><th>دفعات</th></tr></thead>
            <tbody>
            <% for (const row of summary) { %>
                <tr><td><%- row.icon %> <%- esc(row.label) %></td><td><strong><%- toPersian(row.total) %></strong></td><td class="text-muted"><%- toPersian(row.events) %></td></tr>
            <% } %>
            </tbody>
        </table>
        <% } %>
    </div>
</div>

<div class="grid-2">
    <div class="panel-card">
        <h3><span class="em">⚽</span> ثبت عملکرد</h3>
        <form method="POST" action="<%- APP_URL %>/coach/player/<%- p.id %>/performance">
            <input type="hidden" name="_csrf_token" value="<%- escAttr(locals.csrf_token || '') %>">

            <div class="form-group">
                <label for="type">نوع عملکرد *</label>
                <select id="type" name="type" class="form-control" required>
                    <% for (const key of Object.keys(types)) { %>
                    <option value="<%- escAttr(key) %>"><%- types[key].icon %> <%- esc(types[key].label) %> (<%- toPersian(types[key].points) %> امتیاز)</option>
                    <% } %>
                </select>
            </div>

            <div class="form-group">
                <label for="value">تعداد *</label>
                <input type="number" id="value" name="value" class="form-control" min="1" value="1" required>
            </div>

            <div class="form-group">
                <label for="match_type">نوع رویداد</label>
                <select id="match_type" name="match_type" class="form-control">
                    <% for (const key of Object.keys(matchTypes)) { %>
                    <option value="<%- escAttr(key) %>"><%- esc(matchTypes[key]) %></option>
                    <% } %>
                </select>
            </div>

            <div class="form-group">
                <label for="perf_session_date">تاریخ جلسه (شمسی)</label>
                <input type="hidden" class="jalali-date-value" id="perf_session_date" name="session_date"
                       data-format="gregorian" value="">
                <input type="text" class="jalali-date-input" id="perf_session_date_display"
                       data-for="perf_session_date" readonly>
            </div>

            <div class="form-group">
                <label for="description">توضیح / بازخورد</label>
                <textarea id="description" name="description" class="form-control" rows="2"></textarea>
            </div>

            <div class="form-group">
                <label>
                    <input type="checkbox" name="with_score" value="1" checked>
                    امتیاز متناظر هم به بازیکن تعلق بگیرد
                </label>
            </div>

            <button class="btn btn-primary" type="submit">ثبت عملکرد</button>
        </form>
    </div>

    <div class="panel-card">
        <h3><span class="em">⭐</span> ثبت امتیاز</h3>
        <form method="POST" action="<%- APP_URL %>/coach/player/<%- p.id %>/score">
            <input type="hidden" name="_csrf_token" value="<%- escAttr(locals.csrf_token || '') %>">

            <div class="form-group">
                <label for="points">امتیاز * <span class="text-muted">(مثبت یا منفی)</span></label>
                <input type="number" id="points" name="points" class="form-control" value="5" required>
            </div>

            <div class="form-group">
                <label for="reason">بابت</label>
                <input type="text" id="reason" name="reason" class="form-control" placeholder="مثلاً: تلاش ویژه در تمرین">
            </div>

            <div class="form-group">
                <label for="score_session_date">تاریخ (شمسی)</label>
                <input type="hidden" class="jalali-date-value" id="score_session_date" name="session_date"
                       data-format="gregorian" value="">
                <input type="text" class="jalali-date-input" id="score_session_date_display"
                       data-for="score_session_date" readonly>
            </div>

            <button class="btn btn-primary" type="submit">ثبت امتیاز</button>
        </form>

        <p class="text-muted mt-3" style="font-size:.82rem;">
            🔒 اهدای نشان فقط توسط مدیر ارشد باشگاه انجام می‌شود.
        </p>
    </div>
</div>

<div class="panel-card">
    <h3><span class="em">📋</span> تاریخچه حضور و غیاب</h3>
    <div class="flex-between mb-2">
        <span class="chip ok">حاضر: <%- toPersian(attendance.present) %></span>
        <span class="chip danger">غایب: <%- toPersian(attendance.absent) %></span>
        <span class="chip warn">تأخیر: <%- toPersian(attendance.late) %></span>
        <span class="chip neutral">موجه: <%- toPersian(attendance.excused) %></span>
    </div>
    <table class="mini-table">
        <thead><tr><th>تاریخ جلسه</th><th>وضعیت</th></tr></thead>
        <tbody>
        <% for (const r of (attendance.records || []).slice(0, 20)) { %>
            <tr><td><%- toPersian(toJalali(r.session_date)) %></td><td><%- esc(r.status_label) %></td></tr>
        <% } %>
        </tbody>
    </table>
</div>

<div class="grid-2">
    <div class="panel-card">
        <h3><span class="em">🧾</span> عملکردهای ثبت‌شده</h3>
        <% if (performance.length === 0) { %>
            <div class="empty-state"><span class="em">📋</span> رکوردی وجود ندارد.</div>
        <% } else { %>
        <table class="mini-table">
            <thead><tr><th>نوع</th><th>تعداد</th><th>رویداد</th><th>تاریخ</th></tr></thead>
            <tbody>
            <% for (const row of performance) { %>
                <tr>
                    <td><%- esc((types[row.type] || {}).label || row.type) %></td>
                    <td><%- toPersian(row.value) %></td>
                    <td class="text-muted"><%- esc(matchTypes[row.matchType] || row.matchType) %></td>
                    <td class="text-muted"><%- toPersian(toJalali(row.sessionDate || row.createdAt)) %></td>
                </tr>
            <% } %>
            </tbody>
        </table>
        <% } %>
    </div>

    <div class="panel-card">
        <h3><span class="em">⭐</span> امتیازهای ثبت‌شده</h3>
        <% if (scores.length === 0) { %>
            <div class="empty-state"><span class="em">⭐</span> امتیازی ثبت نشده است.</div>
        <% } else { %>
        <table class="mini-table">
            <thead><tr><th>امتیاز</th><th>بابت</th><th>تاریخ</th></tr></thead>
            <tbody>
            <% for (const s of scores) { %>
                <tr>
                    <td class="<%- s.points >= 0 ? 'text-gold' : 'text-danger' %>"><strong><%- s.points > 0 ? '+' : '' %><%- toPersian(s.points) %></strong></td>
                    <td><%- esc(s.reason || dash) %></td>
                    <td class="text-muted"><%- toPersian(toJalali(s.createdAt)) %></td>
                </tr>
            <% } %>
            </tbody>
        </table>
        <% } %>
    </div>
</div>
