<%
/** گزارش عملکرد بازیکنان — امتیاز، نشان‌ها و خلاصه عملکرد در یک جدول */
const rows = locals.rows || [];
const types = locals.performance_types || {};
const typeKeys = Object.keys(types).filter((k) => types[k].points !== 0).slice(0, 6);
const maxTotal = Math.max(1, ...rows.map((r) => r.total));
%>

<div class="tile-grid">
    <div class="tile">
        <span class="tile-icon">👥</span>
        <span class="tile-value"><%- toPersian(rows.length) %></span>
        <span class="tile-label">بازیکن در گزارش</span>
    </div>
    <div class="tile is-gold">
        <span class="tile-icon">⭐</span>
        <span class="tile-value"><%- toPersian(rows.reduce((s, r) => s + (r.total || 0), 0)) %></span>
        <span class="tile-label">مجموع امتیازها</span>
    </div>
    <div class="tile">
        <span class="tile-icon">🏅</span>
        <span class="tile-value"><%- toPersian(rows.reduce((s, r) => s + (r.badges || []).length, 0)) %></span>
        <span class="tile-label">نشان‌های اهداشده</span>
    </div>
</div>

<div class="panel-card">
    <h3><span class="em">📊</span> جدول عملکرد</h3>
    <% if (rows.length === 0) { %>
        <div class="empty-state"><span class="em">📉</span> داده‌ای برای گزارش وجود ندارد.</div>
    <% } else { %>
    <table class="mini-table">
        <thead>
            <tr>
                <th>#</th><th>بازیکن</th><th>کلاس</th>
                <% for (const key of typeKeys) { %><th><%- types[key].icon %></th><% } %>
                <th>نشان</th><th>امتیاز کل</th><th style="width:18%;"></th>
            </tr>
        </thead>
        <tbody>
        <% rows.forEach(function (row, i) { %>
            <% const byType = {}; for (const s of row.summary || []) { byType[s.type] = s.total; } %>
            <tr>
                <td><%- toPersian(i + 1) %></td>
                <td><%- esc(row.name) %></td>
                <td class="text-muted"><%- esc(row.classroom || '—') %></td>
                <% for (const key of typeKeys) { %>
                <td><%- toPersian(byType[key] || 0) %></td>
                <% } %>
                <td>
                    <% for (const b of (row.badges || []).slice(0, 5)) { %><span title="<%- escAttr(b.badgeTitle) %>"><%- b.icon %></span><% } %>
                    <% if ((row.badges || []).length === 0) { %><span class="text-muted">—</span><% } %>
                </td>
                <td><strong class="text-gold"><%- toPersian(row.total) %></strong></td>
                <td><div class="bar-track"><div class="bar-fill gold" style="width:<%- Math.round((row.total / maxTotal) * 100) %>%"></div></div></td>
            </tr>
        <% }); %>
        </tbody>
    </table>

    <p class="text-muted mt-3" style="font-size:.82rem;">
        راهنمای ستون‌ها:
        <% for (const key of typeKeys) { %>
        <span class="chip neutral"><%- types[key].icon %> <%- esc(types[key].label) %></span>
        <% } %>
    </p>
    <% } %>
</div>
