<%
/** امتیازدهی و رتبه‌بندی — امتیاز کل هر بازیکن مجموع ساده امتیازهای ثبت‌شده است */
const players = locals.players || [];
const leaderboard = locals.leaderboard || [];
const maxTotal = Math.max(1, ...leaderboard.map((r) => r.total));
%>

<div class="alert alert-info">
    ⭐ امتیاز کل هر بازیکن برابر است با <strong>جمع ساده تمام امتیازهایی</strong> که مربی یا
    مدیر ارشد برای او ثبت کرده‌اند.
</div>

<div class="grid-2">
    <div class="panel-card">
        <h3><span class="em">➕</span> ثبت امتیاز</h3>
        <form method="POST" action="<%- APP_URL %>/admin/scores">
            <input type="hidden" name="_csrf_token" value="<%- escAttr(locals.csrf_token || '') %>">

            <div class="form-group">
                <label for="player_id">بازیکن *</label>
                <select id="player_id" name="player_id" class="form-control" required>
                    <% for (const p of players) { %>
                    <option value="<%- p.id %>"><%- esc(p.name) %></option>
                    <% } %>
                </select>
            </div>

            <div class="form-group">
                <label for="points">امتیاز * <span class="text-muted">(می‌تواند منفی باشد)</span></label>
                <input type="number" id="points" name="points" class="form-control" value="5" required>
            </div>

            <div class="form-group">
                <label for="reason">بابت</label>
                <input type="text" id="reason" name="reason" class="form-control" placeholder="مثلاً: بازیکن برتر هفته">
            </div>

            <button class="btn btn-primary" type="submit">ثبت امتیاز</button>
        </form>
    </div>

    <div class="panel-card">
        <h3><span class="em">🏆</span> جدول رتبه‌بندی</h3>
        <% if (leaderboard.length === 0) { %>
            <div class="empty-state"><span class="em">⭐</span> هنوز امتیازی ثبت نشده است.</div>
        <% } else { %>
        <table class="mini-table">
            <thead><tr><th>#</th><th>بازیکن</th><th>کلاس</th><th>امتیاز</th><th></th></tr></thead>
            <tbody>
            <% leaderboard.forEach(function (row, i) { %>
                <tr>
                    <td><%- toPersian(i + 1) %></td>
                    <td><%- esc(row.name) %></td>
                    <td class="text-muted"><%- esc(row.classroom || '—') %></td>
                    <td><strong><%- toPersian(row.total) %></strong></td>
                    <td style="width:35%;">
                        <div class="bar-track"><div class="bar-fill gold" style="width:<%- Math.round((row.total / maxTotal) * 100) %>%"></div></div>
                    </td>
                </tr>
            <% }); %>
            </tbody>
        </table>
        <% } %>
    </div>
</div>
