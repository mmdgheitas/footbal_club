<%
/** دفتر هزینه‌های باشگاه — ثبت دستی هزینه‌ها (سالن، چمن، اجاره دفتر، حقوق و ...) */
const rows = locals.rows || [];
const totals = locals.totals || { total: 0, byCategory: [], byMonth: [] };
const categories = locals.categories || {};
const icons = locals.category_icons || {};
const filters = locals.filters || { from: '', to: '', category: '' };
const maxMonth = Math.max(1, ...(totals.byMonth || []).map((m) => m.total));
%>

<div class="tile-grid">
    <div class="tile is-danger">
        <span class="tile-icon">🧾</span>
        <span class="tile-value"><%- __num(totals.total) %></span>
        <span class="tile-label">جمع هزینه‌ها (تومان)</span>
    </div>
    <% for (const c of (totals.byCategory || []).slice(0, 4)) { %>
    <div class="tile">
        <span class="tile-icon"><%- icons[c.category] || '💸' %></span>
        <span class="tile-value"><%- __num(c.total) %></span>
        <span class="tile-label"><%- esc(c.label) %></span>
    </div>
    <% } %>
</div>

<div class="panel-card">
    <h3><span class="em">🔍</span> فیلتر</h3>
    <form method="GET" action="<%- APP_URL %>/admin/expenses" class="grid-2">
        <div class="form-group">
            <label for="from">از تاریخ (شمسی)</label>
            <input type="hidden" class="jalali-date-value" id="from" name="from"
                   data-format="gregorian" value="<%- escAttr(filters.from) %>">
            <input type="text" class="jalali-date-input" id="from_display" data-for="from" readonly>
        </div>
        <div class="form-group">
            <label for="to">تا تاریخ (شمسی)</label>
            <input type="hidden" class="jalali-date-value" id="to" name="to"
                   data-format="gregorian" value="<%- escAttr(filters.to) %>">
            <input type="text" class="jalali-date-input" id="to_display" data-for="to" readonly>
        </div>
        <div class="form-group">
            <label for="category">دسته‌بندی</label>
            <select id="category" name="category" class="form-control">
                <option value="">همه</option>
                <% for (const key of Object.keys(categories)) { %>
                <option value="<%- escAttr(key) %>" <%- filters.category === key ? 'selected' : '' %>>
                    <%- icons[key] || '' %> <%- esc(categories[key]) %>
                </option>
                <% } %>
            </select>
        </div>
        <div class="form-group" style="display:flex;align-items:flex-end;gap:8px;">
            <button class="btn btn-primary" type="submit">اعمال فیلتر</button>
            <a class="btn btn-secondary" href="<%- APP_URL %>/admin/expenses">حذف فیلتر</a>
        </div>
    </form>
</div>

<div class="grid-2">
    <div class="panel-card">
        <h3><span class="em">➕</span> ثبت هزینه جدید</h3>
        <form method="POST" action="<%- APP_URL %>/admin/expenses">
            <input type="hidden" name="_csrf_token" value="<%- escAttr(locals.csrf_token || '') %>">

            <div class="form-group">
                <label for="title">عنوان هزینه *</label>
                <input type="text" id="title" name="title" class="form-control" placeholder="مثلاً اجاره سالن مهرماه" required>
            </div>

            <div class="form-group">
                <label for="amount">مبلغ (تومان) *</label>
                <input type="number" id="amount" name="amount" class="form-control ltr" min="0" step="1000" required>
            </div>

            <div class="form-group">
                <label for="expense_category">دسته‌بندی *</label>
                <select id="expense_category" name="category" class="form-control" required>
                    <% for (const key of Object.keys(categories)) { %>
                    <option value="<%- escAttr(key) %>"><%- icons[key] || '' %> <%- esc(categories[key]) %></option>
                    <% } %>
                </select>
            </div>

            <div class="form-group">
                <label for="expense_date">تاریخ هزینه (شمسی) *</label>
                <input type="hidden" class="jalali-date-value" id="expense_date" name="expense_date"
                       data-format="gregorian" value="">
                <input type="text" class="jalali-date-input" id="expense_date_display"
                       data-for="expense_date" readonly required>
            </div>

            <div class="form-group">
                <label for="note">توضیحات</label>
                <textarea id="note" name="note" class="form-control" rows="2"></textarea>
            </div>

            <button class="btn btn-primary" type="submit">ثبت هزینه</button>
        </form>
    </div>

    <div class="panel-card">
        <h3><span class="em">📈</span> هزینه به تفکیک ماه</h3>
        <% if ((totals.byMonth || []).length === 0) { %>
            <div class="empty-state"><span class="em">📉</span> داده‌ای موجود نیست.</div>
        <% } else { %>
            <% for (const m of totals.byMonth) { %>
            <div style="margin-bottom:10px;">
                <div class="flex-between" style="margin-bottom:4px;">
                    <span class="ltr text-muted"><%- toPersian(m.month) %></span>
                    <strong><%- __num(m.total) %></strong>
                </div>
                <div class="bar-track"><div class="bar-fill" style="width:<%- Math.round((m.total / maxMonth) * 100) %>%"></div></div>
            </div>
            <% } %>
        <% } %>

        <h4 class="mt-3">به تفکیک دسته‌بندی</h4>
        <table class="mini-table">
            <thead><tr><th>دسته</th><th>تعداد</th><th>مبلغ</th></tr></thead>
            <tbody>
            <% for (const c of totals.byCategory || []) { %>
                <tr>
                    <td><%- icons[c.category] || '💸' %> <%- esc(c.label) %></td>
                    <td class="text-muted"><%- toPersian(c.count) %></td>
                    <td><%- __num(c.total) %></td>
                </tr>
            <% } %>
            </tbody>
        </table>
    </div>
</div>

<div class="panel-card">
    <h3><span class="em">🧾</span> فهرست هزینه‌ها (<%- toPersian(rows.length) %>)</h3>
    <% if (rows.length === 0) { %>
        <div class="empty-state"><span class="em">📭</span> هزینه‌ای ثبت نشده است.</div>
    <% } else { %>
    <table class="mini-table">
        <thead><tr><th>تاریخ</th><th>عنوان</th><th>دسته</th><th>مبلغ</th><th>ثبت توسط</th><th>توضیح</th><th></th></tr></thead>
        <tbody>
        <% for (const e of rows) { %>
            <tr>
                <td class="nowrap"><%- toPersian(toJalali(e.expenseDate)) %></td>
                <td><%- esc(e.title) %></td>
                <td class="text-muted"><%- icons[e.category] || '💸' %> <%- esc(categories[e.category] || e.category) %></td>
                <td><strong><%- __num(e.amount) %></strong></td>
                <td class="text-muted"><%- esc(e.recorder ? e.recorder.name : '—') %></td>
                <td class="text-muted"><%- esc(e.note || '—') %></td>
                <td>
                    <form method="POST" action="<%- APP_URL %>/admin/expenses/<%- e.id %>/delete">
                        <input type="hidden" name="_csrf_token" value="<%- escAttr(locals.csrf_token || '') %>">
                        <button class="btn btn-danger" type="submit">حذف</button>
                    </form>
                </td>
            </tr>
        <% } %>
        </tbody>
    </table>
    <% } %>
</div>
