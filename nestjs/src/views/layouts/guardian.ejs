<%
/** پنل ولی — its own layout, separate from the staff dashboard. */
const pageTitle = (locals.title || 'پنل ولی') + ' - ' + APP_NAME;
const currentPath = locals.currentPath || '/guardian';
const unread = locals.unread_count || 0;
const user = locals.user || {};

const nav = [
  { href: '/guardian',               icon: '🏠', label: 'خانه' },
  { href: '/guardian/financial',     icon: '💳', label: 'دفترچه مالی' },
  { href: '/guardian/attendance',    icon: '📋', label: 'حضور و غیاب' },
  { href: '/guardian/cards',         icon: '🪪', label: 'کارت عضویت' },
  { href: '/guardian/notifications', icon: '🔔', label: 'اعلان‌ها' },
];
const isActive = (href) => href === '/guardian' ? currentPath === '/guardian' : currentPath.startsWith(href);
%>
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#C8102E">
    <meta name="app-url" content="<%- escAttr(APP_URL) %>">
    <meta name="csrf-token" content="<%- escAttr(locals.csrf_token || '') %>">
    <title><%- esc(pageTitle) %></title>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%- APP_URL %>/assets/css/style.css?v=<%- locals.assetVer || '' %>">
    <link rel="stylesheet" href="<%- APP_URL %>/assets/css/animations.css?v=<%- locals.assetVer || '' %>">
    <link rel="stylesheet" href="<%- APP_URL %>/assets/css/panels.css?v=<%- locals.assetVer || '' %>">
</head>
<body>
    <div class="panel-shell">
        <div class="panel-topbar">
            <h1><span class="em">👨‍👩‍👦</span> پنل ولی — <%- esc(user.name || '') %></h1>
            <div style="display:flex;gap:8px;align-items:center;">
                <a class="icon-btn" href="<%- APP_URL %>/guardian/notifications" aria-label="اعلان‌ها">
                    🔔<% if (unread > 0) { %><span class="dot"><%- toPersian(unread) %></span><% } %>
                </a>
                <a class="btn btn-secondary" href="<%- APP_URL %>/logout">خروج</a>
            </div>
        </div>

        <nav class="panel-nav">
            <% for (const item of nav) { %>
            <a href="<%- APP_URL %><%- item.href %>" class="<%- isActive(item.href) ? 'active' : '' %>">
                <span class="em"><%- item.icon %></span> <%- esc(item.label) %>
            </a>
            <% } %>
        </nav>

        <% const flashes = locals.flashes || {}; %>
        <% for (const type of Object.keys(flashes)) { %>
          <% for (const message of flashes[type]) { %>
        <div class="alert alert-<%- esc(type) %>"><%- esc(message) %></div>
          <% } %>
        <% } %>

        <h2 style="margin-bottom:14px;color:var(--white);"><%- esc(locals.title || '') %></h2>

        <%- locals.content || '' %>
    </div>

    <script src="<%- APP_URL %>/assets/js/main.js?v=<%- locals.assetVer || '' %>"></script>
</body>
</html>
