<% /**
 * Homework Review List View
 * Coach can review student homework videos
 */
locals.videos = locals.videos ?? [];
const dt = (v) => {
    if (__empty(v)) return '';
    const d = new Date(String(v).replace(' ', 'T'));
    if (isNaN(d.getTime())) return '';
    const p = (n) => String(n).padStart(2, '0');
    return `${d.getFullYear()}/${p(d.getMonth() + 1)}/${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
};
%>


<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">بررسی تمرینات دانش‌آموزان</h2>
                </div>
                <div class="card-body">

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="thead-light">
                                <tr>
                                    <th>بازیکن</th>
                                    <th>عنوان تمرین</th>
                                    <th>کلاس</th>
                                    <th>تاریخ آپلود</th>
                                    <th>وضعیت</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (const video of __iter(locals.videos)) {
                                    let statusLabel = '';
                                    let statusClass = 'secondary';

                                    switch (video['status'] ?? '') {
                                        case 'approved':
                                            statusLabel = 'تایید شده';
                                            statusClass = 'success';
                                            break;
                                        case 'reviewed':
                                            statusLabel = 'بررسی شده';
                                            statusClass = 'info';
                                            break;
                                        case 'submitted':
                                            statusLabel = 'ارسال شده';
                                            statusClass = 'warning';
                                            break;
                                        default:
                                            statusLabel = 'نامشخص';
                                    }
                                %>
                                <tr>
                                    <td>
                                        <strong><%- esc(video['player_name'] ?? 'نامشخص') %></strong>
                                        <% if (!__empty(video['user_name'])) { %>
                                            <br><small class="text-muted"><%- esc(video['user_name']) %></small>
                                        <% } %>
                                    </td>
                                    <td><%- esc(video['title'] ?? 'بدون عنوان') %></td>
                                    <td><%- esc(video['classroom_name'] ?? '-') %></td>
                                    <td><%- esc(dt(video['created_at'] ?? '')) %></td>
                                    <td><span class="badge bg-<%- statusClass %>"><%- statusLabel %></span></td>
                                    <td>
                                        <a href="<%- APP_URL + '/homework/review/' + video['id'] %>" class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye"></i> بررسی
                                        </a>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <% if (__empty(locals.videos)) { %>
                        <div class="alert alert-info">
                            تمرینی برای بررسی وجود ندارد.
                        </div>
                    <% } %>

                </div>
            </div>
        </div>
    </div>
</div>
