<%
/** دفترچه مالی شفاف ولی — تمام پرداخت‌ها، بدهی‌ها و تخفیف‌ها */
const finance = locals.finance || { ledgers: [], totalPaid: 0, totalOutstanding: 0, totalDiscount: 0 };
const kindIcon = { payment: '✅', debt: '⚠️', discount: '🎁' };
/** صورتحساب‌های قابل پرداخت آنلاین (از PaymentService.payableForGuardian) */
const payable = locals.payable || [];
const payableOf = (playerId) => payable.filter((i) => Number(i.playerId) === Number(playerId));
const gatewayTest = !!locals.gateway_test_mode;
%>

<div class="tile-grid">
    <div class="tile">
        <span class="tile-icon">✅</span>
        <span class="tile-value"><%- __num(finance.totalPaid) %></span>
        <span class="tile-label">مجموع پرداختی (تومان)</span>
    </div>
    <div class="tile <%- finance.totalOutstanding > 0 ? 'is-danger' : '' %>">
        <span class="tile-icon">⚠️</span>
        <span class="tile-value"><%- __num(finance.totalOutstanding) %></span>
        <span class="tile-label">مجموع بدهی (تومان)</span>
    </div>
    <div class="tile is-gold">
        <span class="tile-icon">🎁</span>
        <span class="tile-value"><%- __num(finance.totalDiscount) %></span>
        <span class="tile-label">تخفیف‌ها (تومان)</span>
    </div>
</div>

<% if (finance.totalOutstanding > 0) { %>
<div class="alert alert-error">
    ⚠️ بدهی پرداخت‌نشده دارید. می‌توانید همین‌جا به‌صورت آنلاین پرداخت کنید یا با واحد مالی باشگاه هماهنگ نمایید.
</div>
<% } %>

<% if (payable.length > 0) { %>
<div class="panel-card">
    <div class="flex-between mb-2">
        <h3 style="margin:0;"><span class="em">💳</span> پرداخت آنلاین</h3>
        <% if (gatewayTest) { %><span class="chip warn">درگاه در حالت آزمایشی</span><% } %>
    </div>

    <table class="mini-table">
        <thead>
            <tr><th>فرزند</th><th>بابت</th><th>مبلغ (تومان)</th><th>مهلت</th><th></th></tr>
        </thead>
        <tbody>
        <% for (const invoice of payable) { %>
            <tr>
                <td><%- esc(invoice.playerName) %></td>
                <td><%- esc(invoice.description || 'صورتحساب باشگاه') %></td>
                <td><strong><%- __num(invoice.amount) %></strong></td>
                <td class="nowrap">
                    <% if (invoice.dueDate) { %>
                        <span class="<%- invoice.overdue ? 'text-danger' : '' %>">
                            <%- toPersian(toJalali(invoice.dueDate)) %>
                        </span>
                    <% } else { %>—<% } %>
                </td>
                <td class="nowrap">
                    <form method="POST" action="<%- APP_URL %>/payments/start/<%- invoice.id %>">
                        <input type="hidden" name="_csrf_token" value="<%- locals.csrf_token %>">
                        <button type="submit" class="btn btn-sm btn-primary">پرداخت</button>
                    </form>
                </td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>
<% } %>

<% for (const ledger of finance.ledgers || []) { %>
<div class="panel-card">
    <h3><span class="em">👦</span> <%- esc(ledger.playerName) %></h3>

    <div class="flex-between mb-3">
        <span class="chip ok">پرداختی: <%- __num(ledger.totalPaid) %></span>
        <span class="chip <%- ledger.hasDebt ? 'danger' : 'neutral' %>">بدهی: <%- __num(ledger.totalOutstanding) %></span>
        <span class="chip warn">تخفیف: <%- __num(ledger.totalDiscount) %></span>
    </div>

    <% if ((ledger.entries || []).length === 0) { %>
        <div class="empty-state"><span class="em">🧾</span> تراکنشی ثبت نشده است.</div>
    <% } else { %>
    <table class="mini-table">
        <thead>
            <tr><th>تاریخ</th><th>شرح</th><th>مبلغ (تومان)</th><th>وضعیت</th><th>روش / مرجع</th></tr>
        </thead>
        <tbody>
        <% for (const e of ledger.entries) { %>
            <tr>
                <td class="nowrap"><%- e.date ? toPersian(toJalali(e.date)) : '—' %></td>
                <td><%- kindIcon[e.kind] || '•' %> <%- esc(e.title) %></td>
                <td><strong><%- __num(e.amount) %></strong></td>
                <td>
                    <span class="chip <%- e.kind === 'payment' ? 'ok' : (e.kind === 'debt' ? 'danger' : 'warn') %>">
                        <%- esc(e.statusLabel) %>
                    </span>
                </td>
                <td class="text-muted"><%- esc(e.method || e.reference || '—') %></td>
            </tr>
        <% } %>
        </tbody>
    </table>
    <% } %>
</div>
<% } %>

<% if ((finance.ledgers || []).length === 0) { %>
    <div class="empty-state"><span class="em">💳</span> اطلاعات مالی‌ای برای نمایش وجود ندارد.</div>
<% } %>
