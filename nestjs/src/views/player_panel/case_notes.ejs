<% /**
 * Player Panel - Case Notes View
 */
const noteTypeLabels = {
    general: 'عمومی',
    medical: 'پزشکی',
    disciplinary: 'انظباطی',
    achievement: 'دستاورد',
    concern: 'نگرانی',
};
const severityLabels = {
    low: 'کم',
    medium: 'متوسط',
    high: 'بالا',
};
// PHP nl2br(escape($x)) - escape first, then break lines.
const nl2brEsc = (v) => esc(v).replace(/\n/g, '<br />\n');
// PHP date('Y/m/d H:i', strtotime($v))
const dt = (v) => {
    if (__empty(v)) return '';
    const d = new Date(String(v).replace(' ', 'T'));
    if (isNaN(d.getTime())) return '';
    const p = (n) => String(n).padStart(2, '0');
    return `${d.getFullYear()}/${p(d.getMonth() + 1)}/${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
};
%>


<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">یادداشت‌های پرونده من</h2>
                </div>
                <div class="card-body">

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        <span>این یادداشت‌ها توسط مدیران و مربیان برای پرونده شما ثبت شده‌اند.</span>
                    </div>

                    <% if (!__empty(locals.case_notes)) { %>
                        <div class="list-group">
                            <% for (const note of __iter(locals.case_notes)) {
                                const severityClass = ({ low: 'success', medium: 'warning', high: 'danger' })[note['severity']] ?? 'secondary';
                            %>
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <h5 class="mb-0">
                                                <%- esc(note['title'] ?? 'بدون عنوان') %>
                                            </h5>
                                            <span class="badge bg-<%- severityClass %>">
                                                <%- severityLabels[note['severity']] ?? note['severity'] %>
                                            </span>
                                            <span class="badge bg-info">
                                                <%- noteTypeLabels[note['note_type']] ?? note['note_type'] %>
                                            </span>
                                        </div>
                                        <p class="mb-2">
                                            <%- nl2brEsc(note['content'] ?? '') %>
                                        </p>
                                        <div class="d-flex align-items-center gap-3 text-muted small">
                                            <span>
                                                <i class="bi bi-calendar"></i>
                                                <%- esc(dt(note['created_at'] ?? '')) %>
                                            </span>
                                            <% if (!__empty(note['created_by_name'])) { %>
                                                <span>
                                                    <i class="bi bi-person"></i>
                                                    <%- esc(note['created_by_name']) %>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="alert alert-info text-center">
                            <i class="bi bi-info-circle"></i>
                            <p class="mb-0">هیچ یادداشت پرونده‌ای برای شما ثبت نشده است.</p>
                        </div>
                    <% } %>

                </div>
            </div>
        </div>
    </div>
</div>
