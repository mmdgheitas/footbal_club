<% /**
 * Player Panel - Account not linked view
 */ %>
<div style="display: flex; align-items: center; justify-content: center; min-height: 50vh; text-align: center;">
    <div class="card" style="max-width: 480px; padding: 40px; border-top: 4px solid var(--danger-color, #dc3545); box-shadow: 0 4px 20px rgba(0,0,0,0.08); background: white; border-radius: 12px; width: 100%;">
        <span style="font-size: 64px; display: block; margin-bottom: 20px;">⚠️</span>
        <h2 style="color: var(--danger-color, #dc3545); margin-bottom: 16px; font-weight: 700;">عدم اتصال به پرونده بازیکن</h2>
        <p style="color: #666; font-size: 15px; line-height: 1.8; margin-bottom: 24px;">
            حساب کاربری شما در حال حاضر به هیچ پرونده بازیکنی در سیستم متصل نشده است.
            لطفاً با مدیریت باشگاه تماس بگیرید تا پرونده شما را به حساب کاربری‌تان متصل نمایند.
        </p>
        <a href="<%- APP_URL %>/logout" class="btn btn-outline" style="padding: 10px 24px; text-decoration: none; border: 1px solid #ccc; border-radius: 6px; color: #333;">خروج از سیستم</a>
    </div>
</div>
